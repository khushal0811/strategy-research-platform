**/context

# Test files (not needed in production)
**/tests
**/.pytest_cache
**/test_*.py
**/conftest.py

# Frontend (deployed separately on Vercel)
strategy-research-terminal/frontend/

# Environment files (secrets — set via platform env vars)
**/.env
**/.env.local
**/.env.production

# Data (mounted as volume, not baked into image)
**/data/*.parquet

